rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /public/{doc} {
      allow read: if true;
    }
    match /messages/{doc} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 1, 1);
    }
  }
}
